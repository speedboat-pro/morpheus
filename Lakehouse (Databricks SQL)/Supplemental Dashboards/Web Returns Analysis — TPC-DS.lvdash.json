{
  "datasets": [
    {
      "name": "f0dd27d1",
      "displayName": "store_returns",
      "config": {
        "version": "1.1",
        "source": "samples.tpcds_sf1000.store_returns",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "406c7328",
      "displayName": "web_returns",
      "config": {
        "version": "1.1",
        "source": "samples.tpcds_sf1000.web_returns",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "return_count",
            "expr": "COUNT(*)",
            "displayName": "Return Count"
          },
          {
            "name": "total_return_amt",
            "expr": "SUM(wr_return_amt)",
            "displayName": "Total Return Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_return_tax",
            "expr": "SUM(wr_return_tax)",
            "displayName": "Total Return Tax",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_net_loss",
            "expr": "SUM(wr_net_loss)",
            "displayName": "Total Net Loss",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_refunded_cash",
            "expr": "SUM(wr_refunded_cash)",
            "displayName": "Total Refunded Cash",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_return_ship_cost",
            "expr": "SUM(wr_return_ship_cost)",
            "displayName": "Total Return Ship Cost",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_return_amt",
            "expr": "AVG(wr_return_amt)",
            "displayName": "Avg Return Amount",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_return_quantity",
            "expr": "SUM(wr_return_quantity)",
            "displayName": "Total Return Quantity"
          }
        ]
      }
    },
